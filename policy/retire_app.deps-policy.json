{
  "$comment": "dependency-hygiene policy for blivethree/Retirement_App (pilot). Edit to match policy.md. See ~/.agents/skills/dependency-hygiene.",
  "cooldownDays": 14,
  "securityException": true,
  "allowedBaseFamilies": ["debian", "alpine"],
  "allowedBaseImages": [
    "python:3.12-slim-trixie",
    "python:3.12-slim-bookworm",
    "node:22-alpine",
    "nginx:alpine"
  ],
  "requirePin": true,
  "rejectPrerelease": true,
  "rejectEol": true,
  "repos": {
    "retire_app": {
      "defaultBranch": "dev",
      "pythonBases": ["python:3.12-slim-trixie"],
      "nodeBases": ["node:22-alpine"],
      "nginxBases": ["nginx:alpine"]
    }
  }
}
